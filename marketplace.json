dashboard: google_analytics_forecast_dashboard {
  title: "Google Analytics Forecast – ARIMA Insights"
  description: "Forecasted sessions with confidence intervals using BigQuery ML ARIMA model"
  layout: fluid

  element {
    title: "Forecast Line Chart"
    type: line
    explore: google_analytics_forecast
    fields: [forecast_date, forecast_value]
    series_labels: ["Forecasted Sessions"]
    y_axis_labels: ["Sessions"]
    x_axis_label: "Date"
    listen: {}
  }

  element {
    title: "Confidence Bands"
    type: area
    explore: google_analytics_forecast
    fields: [forecast_date, confidence_interval_lower, confidence_interval_upper]
    series_labels: ["Lower Bound", "Upper Bound"]
    y_axis_labels: ["Confidence Range"]
    x_axis_label: "Date"
    listen: {}
  }

  element {
    title: "Forecast Range KPI"
    type: single_value
    explore: google_analytics_forecast
    fields: [forecast_range]
    listen: {}
  }

  element {
    title: "Average Forecast KPI"
    type: single_value
    explore: google_analytics_forecast
    fields: [avg_forecast]
    listen: {}
  }

  element {
    title: "Forecast Table"
    type: table
    explore: google_analytics_forecast
    fields: [forecast_date, forecast_value, confidence_interval_lower, confidence_interval_upper]
    listen: {}
  }

  filter {
    name: "Date Range"
    type: date
    field: forecast_date
  }
}
